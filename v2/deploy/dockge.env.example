# 复制为 Dockge 项目目录中的 .env，填写强密码；不要提交或分享真实文件。
# 宿主机网卡地址，如宿主机的 LAN 地址。暴露 Web 时建议使用 HTTPS 反代。
V2_BIND_ADDRESS=127.0.0.1
V2_WEB_PORT=18088
V2_FLOW_BIND_ADDRESS=127.0.0.1
V2_FLOW_PORT=2056
APP_PASSWORD=

OXIDNS_BASE_URL=http://192.0.2.4:9199
OXIDNS_USERNAME=
OXIDNS_PASSWORD=
NETFLOW_PLUS_BASE_URL=http://192.0.2.36:8080
NETFLOW_PLUS_USERNAME=v2
NETFLOW_PLUS_PASSWORD=
FLOW_EXPORTERS=192.0.2.2
LOCAL_NETWORKS=192.0.2.0/24
FLOW_IGNORE_EXPORT_TARGETS=192.0.2.36:2055,192.0.2.36:2056
DNS_CORRELATION_WINDOW_SECONDS=60
